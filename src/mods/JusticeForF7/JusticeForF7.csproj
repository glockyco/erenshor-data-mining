<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputPath>bin/$(Configuration)/$(TargetFramework)/$(ModLoader)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>JusticeForF7</AssemblyName>
    <RootNamespace>JusticeForF7</RootNamespace>

    <!-- Roslyn Analyzers -->
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Suppress warnings that don't apply to mods -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Exclude tests directory from main project compilation -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>

    <!-- Ship only JusticeForF7.dll; Lunaris provides the shared deps at runtime -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup Condition="'$(ModLoader)' == 'bepinex'">
    <PackageReference Include="BepInEx.Core" Version="5.*" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(ModLoader)' == 'bepinex'">
    <Reference Include="0Harmony">
      <HintPath>lib/bepinex/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Select exactly one loader-specific entrypoint. The SDK's default Compile items
       are removed first so explicit selection never duplicates an entrypoint. -->
  <ItemGroup>
    <Compile Remove="src/JusticeSettings.cs" />
    <Compile Include="src/JusticeSettings.cs" Condition="'$(ModLoader)' == 'lunaris'" />
    <Compile Remove="src/Plugin.cs" />
    <Compile Remove="src/Plugin.BepInEx.cs" />
    <Compile Remove="src/Plugin.Lunaris.cs" />
    <Compile Include="src/Plugin.cs"
              Condition="'$(ModLoader)' == 'lunaris' and !Exists('src/Plugin.Lunaris.cs') and Exists('src/Plugin.cs')" />
    <Compile Include="src/Plugin.BepInEx.cs"
              Condition="'$(ModLoader)' == 'bepinex' and Exists('src/Plugin.BepInEx.cs')" />
    <Compile Include="src/Plugin.Lunaris.cs"
              Condition="'$(ModLoader)' == 'lunaris' and Exists('src/Plugin.Lunaris.cs')" />
  </ItemGroup>

  <!-- Loader and Lunaris-provided shared assembly references (copied via erenshor mod setup) -->
  <ItemGroup Condition="'$(ModLoader)' == 'lunaris'">
    <Reference Include="Lunaris">
      <HintPath>lib/lunaris/Lunaris.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>lib/lunaris/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assembly references (copied via erenshor mod setup) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>lib/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>lib/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>lib/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>lib/UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>lib/UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>lib/Unity.TextMeshPro.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
