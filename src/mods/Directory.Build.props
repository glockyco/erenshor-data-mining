<!-- Applies to every mod project. MSB3277 (assembly-version conflicts during
     ResolveAssemblyReference) is benign here: game/Unity refs are Private=false
     (runtime-provided) and ILRepack excludes System.* shims. Demote to a message
     so it stays in -v normal / binlogs but doesn't bury real errors. NoWarn does
     not work — MSB3277 is an MSBuild task warning, not a compiler one. -->
<Project>
  <PropertyGroup>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
    <!-- Exclude every historical and loader-scoped generated tree before SDK default globs run. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <!-- Loader-specific defaults and intermediate paths apply only to the five production mod projects. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AdventureGuide' or '$(MSBuildProjectName)' == 'InteractiveMapCompanion' or '$(MSBuildProjectName)' == 'MapTileCapture' or '$(MSBuildProjectName)' == 'Sprint' or '$(MSBuildProjectName)' == 'JusticeForF7'">
    <IsModProject>true</IsModProject>
    <ModLoader Condition="'$(ModLoader)' == '' and ('$(MSBuildProjectName)' == 'AdventureGuide' or '$(MSBuildProjectName)' == 'Sprint' or '$(MSBuildProjectName)' == 'JusticeForF7')">lunaris</ModLoader>
    <ModLoader Condition="'$(ModLoader)' == ''">bepinex</ModLoader>
    <BaseIntermediateOutputPath>obj/$(ModLoader)/</BaseIntermediateOutputPath>
    <MSBuildProjectExtensionsPath>$(BaseIntermediateOutputPath)</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'AdventureGuide' or '$(MSBuildProjectName)' == 'InteractiveMapCompanion' or '$(MSBuildProjectName)' == 'MapTileCapture' or '$(MSBuildProjectName)' == 'Sprint' or '$(MSBuildProjectName)' == 'JusticeForF7'">
    <DefineConstants Condition="'$(ModLoader)' == 'lunaris'">$(DefineConstants);LUNARIS</DefineConstants>
    <DefineConstants Condition="'$(ModLoader)' == 'bepinex'">$(DefineConstants);BEPINEX</DefineConstants>
  </PropertyGroup>
</Project>
