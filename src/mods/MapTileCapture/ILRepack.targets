<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!-- ============================================== -->
  <!-- STEP 1: Copy BepInEx for type resolution -->
  <!-- ============================================== -->
  <Target Name="CopyReferenceAssemblies" BeforeTargets="ILRepackMod"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'bepinex'">
    <ItemGroup>
      <BepInExReference Include="@(ReferencePath)"
                        Condition="'%(Filename)%(Extension)' == 'BepInEx.dll'" />
    </ItemGroup>

    <Error Condition="'@(BepInExReference)' == ''"
           Text="Could not resolve BepInEx.dll from the restored BepInEx package." />

    <!-- Copy the assembly selected by NuGet restore for ILRepack type resolution.
         It remains reference-only and is never merged into the plugin. -->
    <Copy SourceFiles="@(BepInExReference)" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />

    <Message Text="Copied BepInEx.dll for ILRepack type resolution" Importance="normal" />
  </Target>

  <!-- ============================================== -->
  <!-- STEP 2: Discover dependencies to merge -->
  <!-- ============================================== -->
  <Target Name="DiscoverDependencies" BeforeTargets="ILRepackMod" DependsOnTargets="CopyReferenceAssemblies"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'bepinex'">
    <ItemGroup>
      <!-- Main assembly (always first) -->
      <MergeAssemblies Include="$(OutputPath)$(TargetName)$(TargetExt)" />

      <!-- NuGet dependencies to merge into the single DLL -->
      <MergeAssemblies Include="$(OutputPath)Fleck.dll" />
      <MergeAssemblies Include="$(OutputPath)Newtonsoft.Json.dll"
                       Condition="'$(ModLoader)' == 'bepinex'" />
    </ItemGroup>

    <!-- Debug output: Show what we're merging -->
    <Message Text="╔════════════════════════════════════════════════════════════╗" Importance="high" />
    <Message Text="║ ILRepack Merge Plan                                       ║" Importance="high" />
    <Message Text="╠════════════════════════════════════════════════════════════╣" Importance="high" />
    <Message Text="%(MergeAssemblies.Filename)%(MergeAssemblies.Extension)" Importance="high" />
    <Message Text="╚════════════════════════════════════════════════════════════╝" Importance="high" />
  </Target>

  <!-- ============================================== -->
  <!-- STEP 3: Run ILRepack to create single DLL -->
  <!-- ============================================== -->
  <Target Name="ILRepackMod" AfterTargets="Build" DependsOnTargets="DiscoverDependencies"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'bepinex'">
    <ILRepack
      Parallel="true"
      DebugInfo="true"
      Internalize="true"
      InputAssemblies="@(MergeAssemblies)"
      LibraryPath="$(OutputPath);$(ProjectDir)lib"
      TargetKind="Dll"
      OutputFile="$(OutputPath)$(TargetName)$(TargetExt)"
    />

    <Message Text="✓ ILRepack: Successfully merged dependencies into $(TargetName)$(TargetExt)" Importance="high" />
  </Target>

  <!-- ============================================== -->
  <!-- STEP 4: Clean up merged DLLs -->
  <!-- ============================================== -->
  <Target Name="CleanupAfterMerge" AfterTargets="ILRepackMod"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'bepinex'">
    <ItemGroup>
      <!-- Keep only the final merged DLL and its companions -->
      <KeepFiles Include="$(OutputPath)$(TargetName).dll" />
      <KeepFiles Include="$(OutputPath)$(TargetName).pdb" />
      <KeepFiles Include="$(OutputPath)$(TargetName).xml" />
      <KeepFiles Include="$(OutputPath)$(TargetName).deps.json" />

      <!-- Delete everything else -->
      <AllFiles Include="$(OutputPath)*.*" />
      <DeleteFiles Include="@(AllFiles)" Exclude="@(KeepFiles)" />
    </ItemGroup>

    <Delete Files="@(DeleteFiles)" />

    <Message Text="✓ Cleaned up build output - single DLL ready for deployment" Importance="high" />
  </Target>

  <!-- Lunaris supplies Newtonsoft.Json and the loader/game references at runtime.
       CopyLocalLockFileAssemblies in the project deliberately copies only Fleck,
       which is the sole dependency merged into the Lunaris plugin. -->
  <Target Name="LunarisDiscoverDependencies" BeforeTargets="LunarisILRepack"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'lunaris'">
    <ItemGroup>
      <LunarisMergeAssemblies Include="$(OutputPath)$(TargetName)$(TargetExt)" />
      <LunarisMergeAssemblies Include="$(OutputPath)Fleck.dll" />
    </ItemGroup>

    <Message Text="╔════════════════════════════════════════════════════════════╗" Importance="high" />
    <Message Text="║ Lunaris ILRepack Merge Plan                              ║" Importance="high" />
    <Message Text="╠════════════════════════════════════════════════════════════╣" Importance="high" />
    <Message Text="%(LunarisMergeAssemblies.Filename)%(LunarisMergeAssemblies.Extension)" Importance="high" />
    <Message Text="╚════════════════════════════════════════════════════════════╝" Importance="high" />
  </Target>

  <Target Name="LunarisILRepack" AfterTargets="Build"
          DependsOnTargets="LunarisDiscoverDependencies"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'lunaris'">
    <ILRepack
      Parallel="true"
      DebugInfo="true"
      Internalize="true"
      InputAssemblies="@(LunarisMergeAssemblies)"
      LibraryPath="$(OutputPath);$(ProjectDir)lib;$(ProjectDir)lib/lunaris"
      TargetKind="Dll"
      OutputFile="$(OutputPath)$(TargetName)$(TargetExt)"
    />

    <Message Text="✓ ILRepack: Merged Fleck into the Lunaris plugin DLL" Importance="high" />
  </Target>

  <Target Name="LunarisCleanupAfterMerge" AfterTargets="LunarisILRepack"
          Condition="'$(SkipILRepack)' != 'true' and '$(ModLoader)' == 'lunaris'">
    <ItemGroup>
      <LunarisKeepFiles Include="$(OutputPath)$(TargetName).dll" />
      <LunarisKeepFiles Include="$(OutputPath)$(TargetName).pdb" />
      <LunarisKeepFiles Include="$(OutputPath)$(TargetName).xml" />
      <LunarisKeepFiles Include="$(OutputPath)$(TargetName).deps.json" />

      <LunarisAllFiles Include="$(OutputPath)*.*" />
      <LunarisDeleteFiles Include="@(LunarisAllFiles)" Exclude="@(LunarisKeepFiles)" />
    </ItemGroup>

    <Delete Files="@(LunarisDeleteFiles)" />

    <Message Text="✓ Cleaned up Lunaris build output - single DLL ready for deployment" Importance="high" />
  </Target>


  <Target Name="SkipILRepackMessage" AfterTargets="Build"
          Condition="'$(SkipILRepack)' == 'true'">
    <Message Text="⊘ ILRepack skipped (SkipILRepack=true) — separate DLLs in output" Importance="high" />
  </Target>

</Project>
