{
  "name": "erenshor",
  "private": true,
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "dev": "pnpm --filter erenshor-maps dev",
    "build": "pnpm --filter erenshor-maps build",
    "preview": "pnpm --filter erenshor-maps preview",
    "check": "pnpm --filter erenshor-maps check",
    "lint": "pnpm --filter erenshor-maps lint",
    "lint:fix": "pnpm --filter erenshor-maps lint:fix",
    "format": "pnpm --filter erenshor-maps format"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "lefthook": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  }
}
