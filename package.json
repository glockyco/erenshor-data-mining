{
  "name": "erenshor",
  "private": true,
  "packageManager": "pnpm@10.34.0",
  "scripts": {
    "prepare": "lefthook install --reset-hooks-path",
    "check": "pnpm --filter erenshor-maps check",
    "lint": "pnpm --filter erenshor-maps lint",
    "lint:fix": "pnpm --filter erenshor-maps lint:fix",
    "format": "pnpm --filter erenshor-maps format",
    "test:wiki-picker": "node --test tests/unit/wiki/semantic-link-picker-core.test.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@johnnymorganz/stylua-bin": "^2.5.2",
    "lefthook": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "@luma.gl/core": "9.3.6",
      "@luma.gl/engine": "9.3.6",
      "@luma.gl/gltf": "9.3.6",
      "@luma.gl/shadertools": "9.3.6",
      "@luma.gl/webgl": "9.3.6"
    }
  }
}
