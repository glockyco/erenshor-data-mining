{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>glockyco/renovate-config"],
  "automerge": false,
  "platformAutomerge": false,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "major": {
    "dependencyDashboardApproval": true
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "automerge": false,
    "dependencyDashboardApproval": false,
    "labels": ["dependencies", "security"]
  },
  "packageRules": [
    {
      "description": "Reserve flake inputs for the dedicated Nix updater",
      "matchManagers": ["nix"],
      "enabled": false
    },
    {
      "description": "Reserve the pnpm toolchain assertion for the Nix updater",
      "matchManagers": ["npm"],
      "matchDepTypes": ["packageManager"],
      "enabled": false
    },
    {
      "description": "Keep the local MediaWiki on the release line of erenshor.wiki.gg. The wiki-dev extensions are cloned from REL1_43 branches, and the stack must mirror the live wiki.",
      "matchManagers": ["dockerfile"],
      "matchPackageNames": ["mediawiki"],
      "allowedVersions": "<1.44"
    },
    {
      "description": "Keep the local MediaWiki database on the major version of erenshor.wiki.gg, which runs MySQL 8.0. The local stack must mirror the live wiki.",
      "matchManagers": ["docker-compose"],
      "matchPackageNames": ["mysql"],
      "allowedVersions": "<9"
    },
    {
      "description": "Label JavaScript dependency updates",
      "matchManagers": ["npm"],
      "addLabels": ["javascript"]
    },
    {
      "description": "Label Python dependency updates",
      "matchManagers": ["pep621", "uv"],
      "addLabels": ["python"]
    },
    {
      "description": "Label .NET dependency updates",
      "matchManagers": ["nuget"],
      "addLabels": ["dotnet"]
    },
    {
      "description": "Require explicit approval for non-security major updates",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "addLabels": ["major"]
    },
    {
      "description": "Group the SvelteKit and Vite compatibility surface",
      "groupName": "SvelteKit and Vite",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@sveltejs/adapter-static",
        "@sveltejs/kit",
        "@sveltejs/vite-plugin-svelte",
        "svelte",
        "vite"
      ]
    },
    {
      "description": "Group the ESLint compatibility surface",
      "groupName": "ESLint",
      "matchManagers": ["npm"],
      "matchPackageNames": [
        "@eslint/compat",
        "@eslint/js",
        "eslint",
        "eslint-config-prettier",
        "eslint-plugin-svelte",
        "globals",
        "typescript-eslint"
      ]
    },
    {
      "description": "Group deck.gl and the luma.gl packages it renders with, released as one suite",
      "groupName": "deck.gl",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@deck\\.gl\\//", "/^@luma\\.gl\\//"]
    },
    {
      "description": "deck.gl 9.4.0 with luma.gl 9.4.2 crashes the GPU process of Steam's embedded Chromium on Windows Direct3D 11 at the first ScatterplotLayer or LineLayer draw, which leaves the companion mod's in-game map white. Remove this rule when a newer release passes the in-game overlay check in the interactive-map skill.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@deck\\.gl\\//", "/^@luma\\.gl\\//"],
      "allowedVersions": "<9.4.0"
    },
    {
      "description": "Group the VSTest-compatible xUnit toolchain",
      "groupName": ".NET test tooling",
      "matchManagers": ["nuget"],
      "matchPackageNames": [
        "Microsoft.NET.Test.Sdk",
        "xunit.runner.visualstudio",
        "xunit.v3"
      ]
    },
    {
      "description": "Keep ImGui.NET on 1.88.0, the version Lunaris supplies at runtime, so both Adventure Guide loader builds run the shared renderer against the same ImGui API and native cimgui. Raise it only together with the Lunaris-supplied ImGui.NET.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["ImGui.NET"],
      "allowedVersions": "<=1.88.0"
    },
    {
      "description": "System.Numerics.Vectors 4.6 ships no net46 facade and resolves netstandard2.1 to an empty placeholder, which breaks the BepInEx Adventure Guide's `vectors` extern alias and its packaged facade.",
      "matchManagers": ["nuget"],
      "matchPackageNames": ["System.Numerics.Vectors"],
      "allowedVersions": "<4.6.0"
    },
    {
      "description": "Group immutable GitHub Actions under one validation boundary",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "addLabels": ["github-actions"]
    }
  ]
}
