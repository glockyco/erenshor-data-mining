# Erenshor environment variables
#
# Copy this file to .env (gitignored). The CLI loads .env at startup, and a
# variable that is already set in the process environment is not replaced.
#
# Configuration does not come from environment variables. The CLI reads it
# from two TOML layers, later layers overriding earlier ones:
#   1. config.toml                  tracked project defaults
#   2. .erenshor/config.local.toml  gitignored local overrides
# Credentials such as the MediaWiki bot password belong in layer 2.
#
# The CLI reads only the variables below. All are optional.

# CrossOver bottle that holds the Steam client. Set it when several bottles
# contain the same variant. Discovery then searches only this bottle.
# CROSSOVER_BOTTLE=Steam

# Lunaris.dll used for mod builds, instead of the one in the game directory or
# the Lunaris library directory.
# ERENSHOR_LUNARIS_DLL=/path/to/Lunaris.dll

# Lunaris compile libraries. Overrides [global.mods] lunaris_lib_dir.
# ERENSHOR_LUNARIS_LIB_DIR=/path/to/Lunaris/Embeds

# Cloudflare API token for `erenshor maps deploy`. Without it, the deploy
# precondition requires an interactive `wrangler login` session.
# CLOUDFLARE_API_TOKEN=

# Thunderstore token for `erenshor mod thunderstore` publication.
# TCLI_AUTH_TOKEN=
